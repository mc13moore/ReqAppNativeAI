# Copy to .env for local development. Never commit the filled-in copy.
# In Azure these are set as container app environment variables by the Bicep
# template, so this file is only for running on your machine.

# ---------------------------------------------------------------------------
# Dynamics 365 Finance & Operations
# ---------------------------------------------------------------------------

# Root URL of the environment. No trailing slash, no /data suffix.
# This doubles as the Entra ID resource: the token scope is <URL>/.default
D365_BASE_URL=https://your-environment.sandbox.operations.dynamics.com

# Legal entity (dataAreaId) used when a request does not name one.
D365_DEFAULT_COMPANY=usmf

# Public OData collection names. Confirm these against your own instance with
# the Diagnostics page, or GET /api/metadata/entities?search=requisition
D365_HEADER_ENTITY=PurchaseRequisitionHeaders
D365_LINE_ENTITY=PurchaseRequisitionLines

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# 'none' skips user sign-in and is only appropriate on localhost.
# In Azure this is set to 'easyauth' so Container Apps enforces sign-in.
AUTH_MODE=none

# Local development authenticates to D365 one of two ways:
#
#   1. `az login` as a user or service principal that D365 recognises.
#      Leave everything below unset -- DefaultAzureCredential finds the CLI.
#
#   2. An app registration. Uncomment and fill these in, and register the
#      same client ID in D365 under
#      System administration > Setup > Microsoft Entra ID applications.
#
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Set only in Azure, by the Bicep template, to select the user-assigned
# managed identity. Leave unset locally.
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
